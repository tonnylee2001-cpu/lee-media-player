<script>

/* ==========================================
   VLC STYLE MEDIA PLAYER
========================================== */

const video = document.getElementById("video");
const fileInput = document.getElementById("fileInput");
const progress = document.getElementById("progress");
const volume = document.getElementById("volume");
const playButton = document.getElementById("playButton");
const muteButton = document.getElementById("muteButton");
const currentTimeElement = document.getElementById("currentTime");
const durationElement = document.getElementById("duration");
const playlistItems = document.getElementById("playlistItems");
const playlistCount = document.getElementById("playlistCount");
const emptyScreen = document.getElementById("emptyScreen");
const videoContainer = document.getElementById("videoContainer");
const dropOverlay = document.getElementById("dropOverlay");

let playlist = [];
let currentIndex = -1;


/* ==========================================
   OPEN FILES
========================================== */

function openFiles() {
    fileInput.click();
}

fileInput.addEventListener("change", function() {

    const files = Array.from(this.files);

    if (files.length > 0) {
        addFiles(files);
    }

    this.value = "";

});


/* ==========================================
   ADD FILES
========================================== */

function addFiles(files) {

    files.forEach(file => {

        if (
            file.type.startsWith("video/") ||
            file.type.startsWith("audio/")
        ) {

            const media = {
                file: file,
                name: file.name,
                type: file.type,
                url: URL.createObjectURL(file)
            };

            playlist.push(media);

        }

    });

    updatePlaylist();

    if (currentIndex === -1 && playlist.length > 0) {
        playMedia(0);
    }

    showToast(
        `${files.length} media file${files.length > 1 ? "s" : ""} added`
    );

}


/* ==========================================
   PLAY MEDIA
========================================== */

function playMedia(index) {

    if (index < 0 || index >= playlist.length) {
        return;
    }

    currentIndex = index;

    const media = playlist[index];

    video.src = media.url;

    video.load();

    video.play()
        .then(() => {
            playButton.textContent = "❚❚";
        })
        .catch(() => {
            playButton.textContent = "▶";
        });

    emptyScreen.style.display = "none";

    updatePlaylist();

}


/* ==========================================
   PLAY / PAUSE
========================================== */

function togglePlay() {

    if (!video.src) {

        if (playlist.length > 0) {
            playMedia(0);
        } else {
            openFiles();
        }

        return;
    }

    if (video.paused) {

        video.play();

    } else {

        video.pause();

    }

}


/* ==========================================
   VIDEO EVENTS
========================================== */

video.addEventListener("play", function() {
    playButton.textContent = "❚❚";
});

video.addEventListener("pause", function() {
    playButton.textContent = "▶";
});

video.addEventListener("timeupdate", function() {

    if (!video.duration) return;

    const percent =
        (video.currentTime / video.duration) * 100;

    progress.value = percent;

    currentTimeElement.textContent =
        formatTime(video.currentTime);

});

video.addEventListener("loadedmetadata", function() {

    durationElement.textContent =
        formatTime(video.duration);

});

video.addEventListener("ended", function() {

    nextMedia();

});


/* ==========================================
   PROGRESS
========================================== */

progress.addEventListener("input", function() {

    if (!video.duration) return;

    video.currentTime =
        (this.value / 100) * video.duration;

});


/* ==========================================
   VOLUME
========================================== */

volume.addEventListener("input", function() {

    video.volume = this.value;

    if (video.volume === 0) {

        muteButton.textContent = "🔇";

    } else {

        muteButton.textContent = "🔊";

    }

});


/* ==========================================
   MUTE
========================================== */

function toggleMute() {

    video.muted = !video.muted;

    muteButton.textContent =
        video.muted ? "🔇" : "🔊";

}


/* ==========================================
   SKIP
========================================== */

function skipForward() {

    if (!video.duration) return;

    video.currentTime =
        Math.min(
            video.currentTime + 10,
            video.duration
        );

}


function skipBackward() {

    video.currentTime =
        Math.max(
            video.currentTime - 10,
            0
        );

}


/* ==========================================
   NEXT / PREVIOUS
========================================== */

function nextMedia() {

    if (playlist.length === 0) return;

    let nextIndex = currentIndex + 1;

    if (nextIndex >= playlist.length) {
        nextIndex = 0;
    }

    playMedia(nextIndex);

}


function previousMedia() {

    if (playlist.length === 0) return;

    let previousIndex = currentIndex - 1;

    if (previousIndex < 0) {
        previousIndex = playlist.length - 1;
    }

    playMedia(previousIndex);

}


/* ==========================================
   PLAYBACK SPEED
========================================== */

function changeSpeed() {

    const speed =
        document.getElementById("speed").value;

    video.playbackRate = Number(speed);

}


/* ==========================================
   FULLSCREEN
========================================== */

function toggleFullscreen() {

    if (!document.fullscreenElement) {

        videoContainer.requestFullscreen()
            .catch(() => {});

    } else {

        document.exitFullscreen();

    }

}


/* ==========================================
   CLEAR PLAYLIST
========================================== */

function clearPlaylist() {

    playlist.forEach(media => {
        URL.revokeObjectURL(media.url);
    });

    playlist = [];
    currentIndex = -1;

    video.pause();
    video.removeAttribute("src");
    video.load();

    emptyScreen.style.display = "block";

    updatePlaylist();

    showToast("Playlist cleared");

}


/* ==========================================
   REMOVE ITEM
========================================== */

function removeItem(index, event) {

    event.stopPropagation();

    URL.revokeObjectURL(playlist[index].url);

    playlist.splice(index, 1);

    if (index === currentIndex) {

        video.pause();

        if (playlist.length > 0) {

            if (index >= playlist.length) {
                currentIndex = playlist.length - 1;
            }

            playMedia(currentIndex);

        } else {

            currentIndex = -1;

            video.removeAttribute("src");
            video.load();

            emptyScreen.style.display = "block";

        }

    } else if (index < currentIndex) {

        currentIndex--;

    }

    updatePlaylist();

}


/* ==========================================
   UPDATE PLAYLIST
========================================== */

function updatePlaylist() {

    playlistItems.innerHTML = "";

    playlist.forEach((media, index) => {

        const item = document.createElement("div");

        item.className =
            "playlist-item " +
            (index === currentIndex ? "active" : "");

        const icon =
            media.type.startsWith("video")
                ? "🎬"
                : "🎵";

        item.innerHTML = `

            <div class="item-icon">
                ${icon}
            </div>

            <div class="item-info">

                <div class="item-name">
                    ${escapeHTML(media.name)}
                </div>

                <div class="item-type">
                    ${media.type.startsWith("video")
                        ? "VIDEO"
                        : "AUDIO"}
                </div>

            </div>

            <button
                class="remove-item"
                title="Remove"
            >
                ✕
            </button>

        `;

        item.addEventListener("click", function() {
            playMedia(index);
        });

        item.querySelector(".remove-item")
            .addEventListener("click", function(event) {
                removeItem(index, event);
            });

        playlistItems.appendChild(item);

    });

    playlistCount.textContent =
        `${playlist.length} item${playlist.length === 1 ? "" : "s"}`;

}


/* ==========================================
   SEARCH
========================================== */

function searchPlaylist() {

    const search =
        document.getElementById("searchInput")
            .value
            .toLowerCase();

    const items =
        document.querySelectorAll(".playlist-item");

    items.forEach((item, index) => {

        const name =
            playlist[index].name.toLowerCase();

        item.style.display =
            name.includes(search)
                ? "flex"
                : "none";

    });

}


/* ==========================================
   TIME FORMAT
========================================== */

function formatTime(seconds) {

    if (!Number.isFinite(seconds)) {
        return "00:00";
    }

    const minutes =
        Math.floor(seconds / 60);

    const remainingSeconds =
        Math.floor(seconds % 60);

    return (
        String(minutes).padStart(2, "0") +
        ":" +
        String(remainingSeconds).padStart(2, "0")
    );

}


/* ==========================================
   TOAST
========================================== */

let toastTimer;

function showToast(message) {

    const toast =
        document.getElementById("toast");

    toast.textContent = message;

    toast.classList.add("show");

    clearTimeout(toastTimer);

    toastTimer = setTimeout(() => {
        toast.classList.remove("show");
    }, 2200);

}


/* ==========================================
   HTML ESCAPE
========================================== */

function escapeHTML(text) {

    const div =
        document.createElement("div");

    div.textContent = text;

    return div.innerHTML;

}


/* ==========================================
   DRAG & DROP
========================================== */

videoContainer.addEventListener("dragover", function(event) {

    event.preventDefault();

    dropOverlay.classList.add("show");

});


videoContainer.addEventListener("dragleave", function(event) {

    if (!videoContainer.contains(event.relatedTarget)) {
        dropOverlay.classList.remove("show");
    }

});


videoContainer.addEventListener("drop", function(event) {

    event.preventDefault();

    dropOverlay.classList.remove("show");

    const files =
        Array.from(event.dataTransfer.files);

    if (files.length > 0) {
        addFiles(files);
    }

});


/* ==========================================
   KEYBOARD SHORTCUTS
========================================== */

document.addEventListener("keydown", function(event) {

    // Don't trigger shortcuts while typing
    if (
        event.target.tagName === "INPUT" ||
        event.target.tagName === "SELECT"
    ) {
        return;
    }

    switch (event.code) {

        case "Space":
            event.preventDefault();
            togglePlay();
            break;

        case "ArrowRight":
            skipForward();
            break;

        case "ArrowLeft":
            skipBackward();
            break;

        case "ArrowUp":
            event.preventDefault();

            video.volume =
                Math.min(video.volume + 0.1, 1);

            volume.value =
                video.volume;

            break;

        case "ArrowDown":
            event.preventDefault();

            video.volume =
                Math.max(video.volume - 0.1, 0);

            volume.value =
                video.volume;

            break;

        case "KeyM":
            toggleMute();
            break;

        case "KeyF":
            toggleFullscreen();
            break;

        case "KeyN":
            nextMedia();
            break;

        case "KeyP":
            previousMedia();
            break;

    }

});


/* ==========================================
   DOUBLE CLICK VIDEO = FULLSCREEN
========================================== */

video.addEventListener("dblclick", function() {
    toggleFullscreen();
});


/* ==========================================
   INITIALIZATION
========================================== */

video.volume = 1;

updatePlaylist();

